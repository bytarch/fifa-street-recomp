diff --git a/src/system/kernel_state.cpp b/src/system/kernel_state.cpp
--- a/src/system/kernel_state.cpp
+++ b/src/system/kernel_state.cpp
@@ -940,6 +940,28 @@
     if (info.guest_path == normalized)
       return info;
   }
+  // A loaded module keeps the VFS path of its file ("\Device\Harddisk0\Partition1\x.xex"),
+  // which normalizes to "device/harddisk0/partition1/x.xex", while the registry holds the
+  // path relative to the game root ("x.xex"). Without this suffix match the recompiled
+  // module is never wired (FIFA Street boots to "function not in function table" the
+  // moment the guest calls into its engine XEX) and unloading a DLL never releases its
+  // recompiled library. Same fix as Gabrick75/fh2-recompiled (Forza Horizon 2, which
+  // unloads and reloads its SpeechFacade module).
+  for (const auto& info : recompiled_modules_) {
+    if (normalized.size() > info.guest_path.size() &&
+        normalized.ends_with(info.guest_path) &&
+        normalized[normalized.size() - info.guest_path.size() - 1] == '/') {
+      REXSYS_WARN("FindRecompiledModule: matched '{}' against registry entry '{}' by suffix",
+                  normalized, info.guest_path);
+      return info;
+    }
+  }
+  REXSYS_ERROR("FindRecompiledModule: '{}' matches none of the {} registered module path(s)",
+               normalized, recompiled_modules_.size());
+  for (const auto& info : recompiled_modules_) {
+    REXSYS_ERROR("  registered: pe='{}' guest='{}' lib='{}'", info.pe_name, info.guest_path,
+                 info.shared_lib_name);
+  }
   return std::nullopt;
 }
 
