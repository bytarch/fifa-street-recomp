+void VirtualFileSystem::SetDefaultBasePath(std::string path) {
+  auto global_lock = global_critical_region_.Acquire();
+  default_base_path_ = std::move(path);
+}
+
+std::string VirtualFileSystem::DefaultBasePath() const {
+  auto global_lock = global_critical_region_.Acquire();
+  return default_base_path_;
+}
+
+std::string VirtualFileSystem::ApplyDefaultBase(std::string_view path) const {
+  auto normalized = std::string(rex::string::utf8_canonicalize_guest_path(path));
+  if (default_base_path_.empty() || normalized.empty()) {
+    return normalized;
+  }
+  if (!rex::string::utf8_find_base_guest_path(normalized).empty()) {
+    return normalized;  // already rooted at a device
+  }
+  return std::string(rex::string::utf8_join_guest_paths(default_base_path_, normalized));
+}
